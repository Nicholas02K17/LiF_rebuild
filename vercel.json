{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["src/**", "dev/**"] }
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["src/**", "dev/**"] }
    },
    {
      "src": "api/diag.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["src/**", "dev/**"] }
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/diag", "dest": "/api/diag.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
