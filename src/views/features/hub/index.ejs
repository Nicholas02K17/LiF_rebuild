<%- include('../../partials/overture') %>
<%- include('../../partials/topbar', { navigation: model.navigation }) %>

<div class="shell__body" data-rail="open">

  <%- include('../../partials/rail', { model: model }) %>

  <main class="stage" id="stage" tabindex="-1">

    <%
      /* ---- 1. Welcome and orientation ---------------------------------
         Priority 1 in the information hierarchy. Personal welcome, pathway
         state when relevant, and the saved return-to-intent action. This is
         what the first viewport says — not counts, not settings
         (Dashboard Unified v1.2 sections 0.4 and 0.5). */
    %>
    <section class="welcome" aria-labelledby="welcome-heading">
      <div class="welcome__copy">
        <h1 class="welcome__greeting lif-enter" style="--i: 0;" id="welcome-heading">
          <% if (model.identity.isFirstVisit) { %>
            Welcome Home,<br><span class="welcome__name"><%= model.identity.playgroundName %></span>.
          <% } else { %>
            Welcome Home,<br><span class="welcome__name"><%= model.identity.playgroundName %></span>.
          <% } %>
        </h1>

        <p class="welcome__orientation lif-enter lif-enter--rise" style="--i: 1;">
          <%= model.welcome.orientation %>
        </p>

        <% if (model.welcome.returnToIntent) { %>
          <p class="welcome__intent lif-enter lif-enter--rise" style="--i: 2;">
            <span class="saved__ring" aria-hidden="true"></span>
            We kept your place at <strong><%= model.welcome.returnToIntent.label %></strong>.
            <a href="<%= model.welcome.returnToIntent.href %>">Go back to it</a>
          </p>
        <% } %>

        <div class="scope lif-enter lif-enter--rise" style="--i: 2;" data-scope="<%= model.scope.current %>">
          <div class="scope__switch" role="group" aria-label="What this page is showing">
            <span class="scope__thumb" data-scope-thumb aria-hidden="true"></span>
            <a class="scope__option" href="/?scope=for-me"
               aria-pressed="<%= model.scope.current === 'for-me' %>"
               data-scope-option="for-me"><%= model.scope.forMeLabel %></a>
            <a class="scope__option" href="/?scope=whole-playground"
               aria-pressed="<%= model.scope.current === 'whole-playground' %>"
               data-scope-option="whole-playground"><%= model.scope.wholeLabel %></a>
          </div>
          <p class="scope__explain" data-scope-explain><%= model.scope.explanation %></p>
        </div>
      </div>

      <%- include('../../partials/pathway-medallion', { pathway: model.pathway, identity: model.identity }) %>
    </section>

    <% if (!model.pathway.allCoreComplete || model.pathway.components.some(function (c) { return !c.complete; })) { %>
      <%- include('../../partials/pathway', { pathway: model.pathway, identity: model.identity }) %>
    <% } %>

    <%
      /* ---- 2. Meaningful current activity ------------------------------
         Context and one direct action per item — never merely a count
         (Dashboard Unified v1.2 section 0.5, priority 2). */
    %>
    <% if (model.activity.length) { %>
      <section aria-labelledby="activity-heading">
        <div class="section-heading">
          <h2 id="activity-heading">Where you already are</h2>
          <% if (model.aspects.filterLabel) { %>
            <a class="chip" href="/"><%= model.aspects.clearLabel %></a>
          <% } %>
        </div>

        <ul class="activity">
          <% model.activity.forEach(function (item, index) { %>
            <li class="activity-item lif-enter" style="--i: <%= index %>;" data-aspect="<%= item.aspectKey %>">
              <svg class="activity-item__dot" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <circle cx="16" cy="16" r="13" />
                <circle cx="16" cy="16" r="5" />
              </svg>

              <div>
                <p class="activity-item__title"><%= item.title %></p>
                <p class="activity-item__context"><%= item.context %></p>
                <p class="activity-item__body"><%= item.body %></p>
              </div>

              <a class="btn activity-item__action" href="<%= item.actionHref %>"><%= item.actionLabel %></a>
            </li>
          <% }); %>
        </ul>
      </section>
    <% } %>

    <%
      /* ---- 3. Discovery ------------------------------------------------
         Every suggestion explains why it appeared, and the route to the Whole
         Playground stays open (Dashboard Unified v1.2 section 0.5, priority 3). */
    %>
    <% if (model.suggestions.length) { %>
      <section aria-labelledby="discovery-heading">
        <div class="section-heading">
          <h2 id="discovery-heading">Because of what you told us</h2>
          <a class="chip" href="/pathway/what-interests-me">Change what interests you</a>
        </div>

        <div class="discovery">
          <% model.suggestions.forEach(function (item, index) { %>
            <a class="suggestion lif-enter" style="--i: <%= index %>;" href="<%= item.href %>" data-aspect="<%= item.aspectKey %>">
              <span class="suggestion__kind"><%= item.kind %></span>
              <span class="suggestion__title"><%= item.title %></span>
              <span class="suggestion__reason"><%= item.reason %></span>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>

    <%
      /* ---- 4. Summaries ------------------------------------------------
         Cards are invitations and doorways (Dashboard Unified v1.2 section 0.6).
         They come last in the source and last on the screen, because welcome
         and purpose precede administration and statistics. */
    %>
    <section aria-labelledby="cards-heading" data-cards-region>
      <div class="section-heading">
        <h2 id="cards-heading">Your Playground</h2>
        <span class="saved" data-saved aria-live="polite">
          <span class="saved__ring" aria-hidden="true"></span>
          <%= model.states.saved %>
        </span>
      </div>

      <ul class="cards-grid" data-cards>
        <% model.cards.visible.forEach(function (card, index) { %>
          <%- include('../../partials/summary-card', {
                card: card, cards: model.cards, states: model.states, index: index
              }) %>
        <% }); %>
      </ul>

      <% if (!model.cards.visible.length) { %>
        <p class="lede">
          Every card is hidden right now. Everything is still reachable from
          <em>Go to</em> in the side panel, and
          <a href="#rail"><%= model.cards.restoreLabel %></a> will bring them back.
        </p>
      <% } %>
    </section>
  </main>
</div>

<footer class="page-footer">
  <p>Love is Foundation · <%= model.identity.playgroundName %> · <%= model.identity.country %></p>
</footer>

<% if (model.page.reviewState) { %>
  <div class="review-flag">
    <span>Reviewing the <strong><%= model.page.reviewState %></strong> state</span>
    <a href="/">back to normal</a>
  </div>
<% } %>
