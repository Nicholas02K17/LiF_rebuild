# LiF Playground — LOCAL development sample.
#
# This file is for running the Hub on your own machine. It is NOT a list of
# variables to set on a hosting platform.
#
# On Vercel / Render / Railway, set exactly ONE variable:
#
#     LIF_REVIEW_DEPLOYMENT=true
#
# Leave NODE_ENV and PORT alone — the platform sets both, and overriding
# NODE_ENV with an empty value makes the app think it is running locally.
# Never commit a real .env.

# Optional locally; defaults to development.
NODE_ENV=development

# Optional locally; defaults to 3000. Hosting platforms set this themselves.
PORT=3000

# Data adapter binding.
# development | test -> the in-repo dev adapter under /dev is permitted.
# production         -> a real repository adapter MUST be bound by the host
#                       application; the dev adapter refuses to load unless
#                       LIF_REVIEW_DEPLOYMENT=true declares a public preview.
LIF_DATA_ADAPTER=dev

# Set ONLY on a hosted preview that has no LiF backend behind it. It runs on
# the fixtures in /dev and shows a banner on every page saying so.
# LIF_REVIEW_DEPLOYMENT=true

# Read by the HOST LiF application, not by this presentation layer.
# Nothing here uses it; it is listed so the host's own setup is complete.
SESSION_SECRET=replace-me-in-the-host-application
