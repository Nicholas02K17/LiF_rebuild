# LiF Playground — presentation layer environment sample.
# Never commit a real .env. Values here are non-sensitive samples only.

NODE_ENV=development
PORT=3000

# Data adapter binding.
# development | test  -> the in-repo dev adapter under /dev is permitted.
# production          -> a real repository adapter MUST be bound by the host
#                        application; the dev adapter refuses to load.
LIF_DATA_ADAPTER=dev

# Session secret is supplied by the host application in the real repository.
SESSION_SECRET=replace-me-in-the-host-application
